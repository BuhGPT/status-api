// BuhGPT Статус — проверка ИС ЭСФ перед отправкой. Данные: BuhGPT Статус — buhgpt.kz/status
// Вызывайте, когда отправка ЭСФ завершилась ошибкой: подскажет пользователю, где проблема.

Функция СтатусСистемыBuhGPT(ИдентификаторСистемы = "esf", Язык = "ru") Экспорт

	Попытка
		Соединение = Новый HTTPСоединение("buhgpt.kz", 443, , , , 10, Новый ЗащищенноеСоединениеOpenSSL);
		Запрос = Новый HTTPЗапрос("/status/api/pulse/v1/context?service=" + ИдентификаторСистемы + "&lang=" + Язык);
		Ответ = Соединение.Получить(Запрос);
		Если Ответ.КодСостояния <> 200 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
		Возврат ПрочитатьJSON(Чтение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Процедура ПоказатьСтатусЭСФ() Экспорт

	Статус = СтатусСистемыBuhGPT("esf");
	Если Статус = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Сообщить(Статус.service_name + ": " + Статус.status_label + ". " + Статус.advice);
	Сообщить(Статус.attribution);

КонецПроцедуры
